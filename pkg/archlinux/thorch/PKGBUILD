# Local package of the maintained InputPlumber checkout and its aarch64 executable.
pkgname=thorch-inputplumber
pkgver=0.82.0
pkgrel=8
pkgdesc='Input routing with Thor SSC motion and source-local calibration sessions'
arch=(aarch64)
url='https://github.com/lurenjiamax/InputPlumber'
license=(GPL3)
depends=(dbus glibc libevdev libgcc libiio polkit systemd-libs)
optdepends=('thorch-motion: optional Qualcomm SSC motion runtime')
provides=(inputplumber)
conflicts=(inputplumber inputplumber-bin inputplumber-git)
options=(!strip)
_root="$(git -C "$startdir" rev-parse --show-toplevel)"
_platform="$_root/pkg/archlinux/thorch"

package() {
  local binary="${CARGO_TARGET_DIR:-$_root/target}/aarch64-unknown-linux-gnu/release/inputplumber"
  [[ $(readelf -h "$binary") == *AArch64* ]] || return 1
  cp -a "$_root/rootfs/." "$pkgdir/"
  cp -a "$_platform/payload/." "$pkgdir/"
  install -Dm755 "$binary" "$pkgdir/usr/bin/inputplumber"
  install -Dm644 "$_platform/inputplumber-restart.conf" "$pkgdir/usr/lib/systemd/system/inputplumber.service.d/90-restart.conf"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_root/docs/calibration-sessions.md" "$pkgdir/usr/share/doc/$pkgname/calibration-sessions.md"
  local record="$pkgdir/usr/share/doc/$pkgname/build-source"
  install -d "$record"
  git -C "$_root" rev-parse HEAD > "$record/revision"
  git -C "$_root" diff HEAD --binary > "$record/local-changes.patch"
  sha256sum "$binary" "$_root/Cargo.lock" > "$record/checksums"
  find "$_platform/payload" -type f -exec sha256sum {} + >> "$record/checksums"
}
